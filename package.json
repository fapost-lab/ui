{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@fapost/ui",
    "version": "0.1.1",
    "description": "The FaPost console kit: Warm Minimal design tokens, a Tailwind 4 theme and Vue 3 components on reka-ui, shipped as source.",
    "keywords": [
        "fapost",
        "vue",
        "tailwindcss",
        "reka-ui",
        "shadcn-vue",
        "design-tokens",
        "inertia"
    ],
    "homepage": "https://github.com/fapost-lab/ui#readme",
    "bugs": "https://github.com/fapost-lab/ui/issues",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fapost-lab/ui.git"
    },
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "src",
        "!src/**/*.test.ts",
        "surface.json"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./components/*": "./src/components/*/index.ts",
        "./lib/utils": "./src/lib/utils.ts",
        "./lib/relative-time": "./src/lib/relative-time.ts",
        "./lib/messages": "./src/lib/messages.ts",
        "./styles.css": "./src/styles/styles.css",
        "./theme.css": "./src/styles/theme.css",
        "./tokens.css": "./src/styles/tokens.css",
        "./fonts.css": "./src/styles/fonts.css",
        "./surface.json": "./surface.json",
        "./package.json": "./package.json"
    },
    "scripts": {
        "type-check": "vue-tsc --noEmit",
        "test": "vitest run",
        "check-exports": "node scripts/check-exports.mjs",
        "smoke": "node smoke/run.mjs"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^3",
        "reka-ui": "^2.11",
        "tailwindcss": "^4",
        "vue": "^3.5",
        "vue-sonner": "^2"
    },
    "dependencies": {
        "@fontsource-variable/onest": "^5.3.1",
        "@fontsource-variable/roboto-condensed": "^5.3.0",
        "@fontsource-variable/victor-mono": "^5.3.0",
        "@lucide/vue": "^1.53.0",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^3.7.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.1",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/test-utils": "^2.5.1",
        "happy-dom": "^21.0.4",
        "reka-ui": "^2.11.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "vue": "^3.5.32",
        "vue-sonner": "^2.0.9",
        "vue-tsc": "^3.2.7"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "allowScripts": {
        "fsevents@2.3.3": true
    }
}
